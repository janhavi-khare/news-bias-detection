# News Bias Detection Configuration

# Path to the fine-tuned RoBERTa model checkpoint directory
MODEL_DIR=newsbias_roberta_best

# API Server Host and Port
API_HOST=127.0.0.1
API_PORT=8000

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Device configuration: 'auto', 'cpu', or 'cuda'
DEVICE=auto

# SHAP explainer evaluation budget (default: 50 for quick interactive response)
SHAP_MAX_EVALS=50
